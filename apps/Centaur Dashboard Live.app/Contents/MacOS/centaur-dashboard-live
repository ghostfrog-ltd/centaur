#!/bin/bash
set -euo pipefail

PROJECT_ROOT="/Volumes/Bob/www/ghostfrog-centaur"
LOG_DIR="$HOME/.centaur/runtime"
LOG_FILE="$LOG_DIR/dashboard_launcher.log"

mkdir -p "$LOG_DIR"
echo "[$(date)] Launching Centaur dashboard LIVE bundle..." >> "$LOG_FILE"

if [ ! -d "$PROJECT_ROOT" ]; then
  echo "[$(date)] ERROR: project root not found at $PROJECT_ROOT" >> "$LOG_FILE"
  osascript -e 'display alert "Centaur Dashboard Live" message "Project root was not found on /Volumes/Bob." as critical'
  exit 1
fi

PYTHON_CANDIDATES=(
  "/Library/Frameworks/Python.framework/Versions/Current/bin/python3"
  "/Library/Frameworks/Python.framework/Versions/3.13/bin/python3"
  "/usr/bin/python3"
)

PYTHON_BIN=""
for candidate in "${PYTHON_CANDIDATES[@]}"; do
  if [ -x "$candidate" ]; then
    PYTHON_BIN="$candidate"
    break
  fi
done

if [ -z "$PYTHON_BIN" ]; then
  echo "[$(date)] ERROR: no usable python3 executable found" >> "$LOG_FILE"
  osascript -e 'display alert "Centaur Dashboard Live" message "No usable python3 executable was found." as critical'
  exit 1
fi

cd "$PROJECT_ROOT"
echo "[$(date)] LIVE bundle using $PYTHON_BIN" >> "$LOG_FILE"
exec env -i \
  HOME="$HOME" \
  PATH="/usr/bin:/bin:/usr/sbin:/sbin:/Library/Frameworks/Python.framework/Versions/Current/bin" \
  PYTHONDONTWRITEBYTECODE=1 \
  PYTHONUNBUFFERED=1 \
  OPERATIONS_DB_BACKEND=postgres \
  "$PYTHON_BIN" "$PROJECT_ROOT/main.py" --dashboard >> "$LOG_FILE" 2>&1
