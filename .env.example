ALPACA_CRYPTO_LOCATION=us
ALPACA_CRYPTO_SYMBOLS=BTC/USD,ETH/USD,SOL/USD,XRP/USD,DOGE/USD,LTC/USD,BCH/USD,LINK/USD,AVAX/USD,UNI/USD,AAVE/USD
