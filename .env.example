# Project Centaur local environment template
#
# This is the single runtime config file. Keep paper and live levers separate
# below so operator changes are explicit and auditable.

###############################################################################
# CORE SETTINGS
#
# Shared runtime, database, research, market-data discovery, cost, and provider
# settings. These apply across modes and do not by themselves authorize paper or
# live order mutation.
###############################################################################

CENTAUR_MODE=paper
CENTAUR_ENVIRONMENT=paper
CENTAUR_ENV=development
CENTAUR_TIMEZONE=Europe/London
MARKET_TIMEZONE=America/New_York
LOG_LEVEL=INFO

CONTROL_TICK_INTERVAL_SECONDS=30
CONTROL_MAX_TICK_RUNTIME_SECONDS=55
CONTROL_ENABLE_PROFILING=true
CONTROL_REFRESH_DASHBOARD_SNAPSHOT=false
CONTROL_LOCK_NAME=centaur_control_tick

OPERATIONS_DB_BACKEND=postgres
CORE_POSTGRES_SCHEMA=core
PAPER_POSTGRES_SCHEMA=paper
LIVE_POSTGRES_SCHEMA=live
POSTGRES_SCHEMA=
USAGE_LEDGER_DB_PATH=.runtime/centaur_usage.sqlite3
API_DAILY_COST_WARNING_USD=5.00
API_DAILY_COST_LIMIT_USD=20.00
SLACK_ALERTS_ENABLED=false
SLACK_WEBHOOK_URL=
SLACK_ALERT_DEDUPE_MINUTES=360
SLACK_REQUEST_TIMEOUT_SECONDS=5
SLACK_HOURLY_STATUS_ENABLED=true
SLACK_HOURLY_STATUS_INTERVAL_MINUTES=60
TEST_MONITOR_ENABLED=true
TEST_MONITOR_COMMAND=
TEST_MONITOR_SLACK_ENABLED=
TEST_MONITOR_REMINDER_MINUTES=60
TEST_MONITOR_OUTPUT_TAIL_LINES=80
TEST_MONITOR_SCHEDULER_FRESHNESS_ENABLED=true
TEST_MONITOR_SCHEDULER_MAX_AGE_MINUTES=10
TEST_MONITOR_STATE_PATH=.runtime/test_monitor_state.json
TEST_MONITOR_LOG_PATH=logs/test_monitor.log
LIVE_EQUITY_PDT_REVIEW_REMINDERS_ENABLED=true
LIVE_EQUITY_PDT_REVIEW_REMINDER_START_DATE=2026-06-04
LIVE_EQUITY_PDT_REVIEW_REMINDER_INTERVAL_MINUTES=30

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ghostfrog_centaur
POSTGRES_USER=replace_me
POSTGRES_PASSWORD=replace_me
POSTGRES_SSLMODE=prefer
DATABASE_URL=postgresql://replace_me:replace_me@127.0.0.1:5432/ghostfrog_centaur

GEMINI_API_KEY=replace_me
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
# Recommended pinned default for stable cost accounting.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ANALYSIS_ENABLED=true
GEMINI_REQUEST_TIMEOUT_SECONDS=20
GEMINI_ANALYSIS_CANDIDATE_LIMIT=5
GEMINI_MAX_OUTPUT_TOKENS=1200
GEMINI_INPUT_COST_PER_MILLION_TOKENS_USD=0.30
GEMINI_OUTPUT_COST_PER_MILLION_TOKENS_USD=2.50

SHADOW_ENABLED=true
SHADOW_PROPOSAL_LIMIT=3
SHADOW_PROPOSAL_COOLDOWN_MINUTES=60
SHADOW_MIN_OPPORTUNITY_SCORE=55
SHADOW_STOP_LOSS_PCT=2
SHADOW_TARGET_MULTIPLE=2.0
SHADOW_CHECKPOINT_WINDOWS=15m,1h,1d,7d
SHADOW_PROFIT_TARGET_LADDER_PCT=1.25,2,3,4,6
SHADOW_EXECUTION_SPREAD_BPS=4.0
SHADOW_ENTRY_SLIPPAGE_BPS=2.0
SHADOW_EXIT_SLIPPAGE_BPS=2.0
SHADOW_FIXED_ROUND_TRIP_COST_USD=0.03

STRATEGY_FITNESS_LOOKBACK_DAYS=0
STRATEGY_FITNESS_MIN_CHECKPOINTS=1
STRATEGY_ALLOCATION_MIN_CHECKPOINTS=2
STRATEGY_ALLOCATION_FAVOR_THRESHOLD=3.0
STRATEGY_ALLOCATION_SUPPRESS_THRESHOLD=-5.60
STRATEGY_ALLOCATION_CRYPTO_SUPPRESS_THRESHOLD=-6.90
STRATEGY_THRESHOLD_ADAPTIVE_ENABLED=true
STRATEGY_THRESHOLD_ADAPTIVE_FLOOR=-6.40
STRATEGY_THRESHOLD_ADAPTIVE_CEILING=-5.60
STRATEGY_THRESHOLD_ADAPTIVE_BAND_WIDTH=0.10
STRATEGY_THRESHOLD_ADAPTIVE_CLIFF_SAFETY_GAP=0.10
STRATEGY_THRESHOLD_ADAPTIVE_MAX_STEP=0.10
STRATEGY_THRESHOLD_ADAPTIVE_MIN_CONFIDENCE=medium
STRATEGY_THRESHOLD_ADAPTIVE_COOLDOWN_MINUTES=30
STRATEGY_THRESHOLD_ADAPTIVE_MIN_TICKS=120

ALPACA_DATA_BASE_URL=https://data.alpaca.markets
