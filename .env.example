WEBHOOK_SECRET=replace_me

###############################################################################
# PAPER SETTINGS
#
# Alpaca Paper credentials and paper execution levers. Paper remains the proving
# lane: $10 entries, one order per tick, 10 base slots, $2 daily protector, and
# long-only approved strategies unless an explicit human override changes it.
###############################################################################

ALPACA_API_KEY=replace_me
ALPACA_SECRET_KEY=replace_me
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_REQUEST_COST_USD=0.00

PAPER_EXECUTION_ENABLED=false
PAPER_EXECUTION_KILL_SWITCH=true
PAPER_EXECUTION_REQUIRE_MARKET_OPEN=true
PAPER_EXECUTION_EQUITY_ONLY=false
PAPER_EXECUTION_MAX_ORDERS_PER_TICK=1
PAPER_EXECUTION_MAX_OPEN_POSITIONS=10
PAPER_EXECUTION_DEFAULT_NOTIONAL_USD=10.00
PAPER_EXECUTION_MAX_DAILY_DRAWDOWN_USD=2.00
PAPER_EXECUTION_STALE_ORDER_MINUTES=5
PAPER_EXECUTION_MIN_PROJECTED_GAIN_PCT=1.5
PAPER_EXECUTION_CRYPTO_MIN_PROJECTED_GAIN_PCT=2
PAPER_EXECUTION_PROFIT_CAPTURE_PCT=1.25
PAPER_EXECUTION_LIMIT_BUFFER_BPS=5.0
PAPER_EXECUTION_CRYPTO_LIMIT_BUFFER_BPS=25.0
PAPER_MIN_SIGNAL_SCORE_TO_TRADE=90.0
PAPER_EXECUTION_EQUITY_NO_WEEKEND_CARRY_ENABLED=true
PAPER_EXECUTION_EQUITY_FRIDAY_ENTRY_CUTOFF_MINUTES_BEFORE_CLOSE=60
PAPER_EXECUTION_EQUITY_FRIDAY_FLATTEN_MINUTES_BEFORE_CLOSE=15
PAPER_EXECUTION_EQUITY_BROKER_ID=alpaca_paper
PAPER_EXECUTION_CRYPTO_BROKER_ID=alpaca_paper
PAPER_EXECUTION_ALLOWED_STRATEGIES=mean_reversion.snapback,crypto_momentum.trend,momentum.volatility_breakout
PAPER_CRYPTO_MOMENTUM_STOP_LOSS_PCT=1
PAPER_CRYPTO_MOMENTUM_TARGET_MULTIPLE=2.0
PAPER_CRYPTO_MOMENTUM_MIN_SIGNAL_SCORE=60.0
PAPER_CRYPTO_MOMENTUM_MIN_MOVEMENT_PCT=0.15
PAPER_CRYPTO_MOMENTUM_MAX_MOVEMENT_PCT=2.5
PAPER_CRYPTO_MOMENTUM_MIN_DISCOVERY_SCORE=2.5
PAPER_CRYPTO_MOMENTUM_MIN_TRADE_COUNT=2
PAPER_CRYPTO_MOMENTUM_MIN_VOLUME_GBP=50000
PAPER_CRYPTO_MOMENTUM_MAX_SPREAD_PCT=0.25
TRAILING_DRAWDOWN_OBSERVER_ENABLED=true
TRAILING_DRAWDOWN_OBSERVER_PAPER_GIVEBACK_USD=2.00
TRAILING_DRAWDOWN_OBSERVER_PAPER_GIVEBACK_PCT=0.00

###############################################################################
# LIVE SETTINGS
#
# Real-money Alpaca Live follower settings. Live is approved only as
# same-as-paper: same strategies, asset classes, $10 entries, 10 base slots, one
# order per tick, $2 daily protector, shared paper/shadow fitness, plus live
# activation, credential, readiness, kill-switch, and same-paper-order guards.
###############################################################################

ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets
ALPACA_LIVE_REQUEST_COST_USD=0.00

LIVE_EXECUTION_ENABLED=false
LIVE_EXECUTION_KILL_SWITCH=true
LIVE_EXECUTION_REQUIRE_MARKET_OPEN=true
LIVE_EXECUTION_EQUITY_ONLY=false
LIVE_EXECUTION_MAX_ORDERS_PER_TICK=1
LIVE_EXECUTION_MAX_OPEN_POSITIONS=10
LIVE_EXECUTION_DEFAULT_NOTIONAL_USD=10.00
LIVE_EXECUTION_MAX_DAILY_DRAWDOWN_USD=2.00
LIVE_EXECUTION_STALE_ORDER_MINUTES=5
LIVE_EXECUTION_MIN_PROJECTED_GAIN_PCT=1.5
LIVE_EXECUTION_CRYPTO_MIN_PROJECTED_GAIN_PCT=2
LIVE_EXECUTION_PROFIT_CAPTURE_PCT=1.25
LIVE_EXECUTION_LIMIT_BUFFER_BPS=5.0
LIVE_EXECUTION_CRYPTO_LIMIT_BUFFER_BPS=25.0
LIVE_MIN_SIGNAL_SCORE_TO_TRADE=90.0
LIVE_EXECUTION_EQUITY_NO_WEEKEND_CARRY_ENABLED=true
LIVE_EXECUTION_EQUITY_FRIDAY_ENTRY_CUTOFF_MINUTES_BEFORE_CLOSE=60
LIVE_EXECUTION_EQUITY_FRIDAY_FLATTEN_MINUTES_BEFORE_CLOSE=15
LIVE_EXECUTION_EQUITY_BROKER_ID=alpaca_live
LIVE_EXECUTION_CRYPTO_BROKER_ID=alpaca_live
LIVE_EXECUTION_ALLOWED_STRATEGIES=mean_reversion.snapback,crypto_momentum.trend,momentum.volatility_breakout
LIVE_CRYPTO_MOMENTUM_STOP_LOSS_PCT=1
LIVE_CRYPTO_MOMENTUM_TARGET_MULTIPLE=2.0
LIVE_CRYPTO_MOMENTUM_MIN_SIGNAL_SCORE=60.0
LIVE_CRYPTO_MOMENTUM_MIN_MOVEMENT_PCT=0.15
LIVE_CRYPTO_MOMENTUM_MAX_MOVEMENT_PCT=2.5
LIVE_CRYPTO_MOMENTUM_MIN_DISCOVERY_SCORE=2.5
LIVE_CRYPTO_MOMENTUM_MIN_TRADE_COUNT=2
LIVE_CRYPTO_MOMENTUM_MIN_VOLUME_GBP=50000
LIVE_CRYPTO_MOMENTUM_MAX_SPREAD_PCT=0.25
LIVE_EXECUTION_ACTIVATION_ACK=
# Leave empty for same-as-paper. To permit a reviewed live difference, list the
# exact validator name, e.g. execution_default_notional_usd or
# crypto_momentum_min_signal_score.
LIVE_EXECUTION_ALLOWED_PAPER_DIFFERENCES=
TRAILING_DRAWDOWN_OBSERVER_LIVE_GIVEBACK_USD=2.00
TRAILING_DRAWDOWN_OBSERVER_LIVE_GIVEBACK_PCT=0.00
