# Project Centaur local environment template

# Application
CENTAUR_ENV=development
CENTAUR_TIMEZONE=Europe/London
MARKET_TIMEZONE=America/New_York
LOG_LEVEL=INFO

# Control pipeline
CONTROL_TICK_INTERVAL_SECONDS=60
CONTROL_MAX_TICK_RUNTIME_SECONDS=55
CONTROL_ENABLE_PROFILING=true
CONTROL_LOCK_NAME=centaur_control_tick

# Usage and budgeting
OPERATIONS_DB_BACKEND=postgres
USAGE_LEDGER_DB_PATH=var/centaur_usage.sqlite3
API_DAILY_COST_WARNING_USD=5.00
API_DAILY_COST_LIMIT_USD=20.00

# Gemini API
GEMINI_API_KEY=replace_me
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
# Recommended pinned default for stable cost accounting.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ANALYSIS_ENABLED=true
GEMINI_REQUEST_TIMEOUT_SECONDS=20
GEMINI_ANALYSIS_CANDIDATE_LIMIT=5
GEMINI_MAX_OUTPUT_TOKENS=1200
GEMINI_INPUT_COST_PER_MILLION_TOKENS_USD=0.30
GEMINI_OUTPUT_COST_PER_MILLION_TOKENS_USD=2.50
SHADOW_ENABLED=true
SHADOW_PROPOSAL_LIMIT=3
SHADOW_PROPOSAL_COOLDOWN_MINUTES=60
SHADOW_MIN_OPPORTUNITY_SCORE=55
SHADOW_STOP_LOSS_PCT=0.02
SHADOW_TARGET_MULTIPLE=2.0
SHADOW_CHECKPOINT_WINDOWS=15m,1h,1d
SHADOW_EXECUTION_SPREAD_BPS=4.0
SHADOW_ENTRY_SLIPPAGE_BPS=2.0
SHADOW_EXIT_SLIPPAGE_BPS=2.0
SHADOW_FIXED_ROUND_TRIP_COST_USD=0.03
STRATEGY_FITNESS_LOOKBACK_DAYS=0
STRATEGY_FITNESS_MIN_CHECKPOINTS=1
STRATEGY_ALLOCATION_MIN_CHECKPOINTS=2
STRATEGY_ALLOCATION_FAVOR_THRESHOLD=3.0
STRATEGY_ALLOCATION_SUPPRESS_THRESHOLD=-5.0
PAPER_EXECUTION_ENABLED=false
PAPER_EXECUTION_KILL_SWITCH=true
PAPER_EXECUTION_REQUIRE_MARKET_OPEN=true
PAPER_EXECUTION_EQUITY_ONLY=false
PAPER_EXECUTION_MAX_ORDERS_PER_TICK=1
PAPER_EXECUTION_MAX_OPEN_POSITIONS=10
PAPER_EXECUTION_DEFAULT_NOTIONAL_USD=10.00
PAPER_EXECUTION_MAX_DAILY_DRAWDOWN_USD=5.00
PAPER_EXECUTION_STALE_ORDER_MINUTES=5
PAPER_EXECUTION_MIN_PROJECTED_GAIN_PCT=0.015
PAPER_EXECUTION_LIMIT_BUFFER_BPS=5.0
PAPER_EXECUTION_EQUITY_BROKER_ID=alpaca_paper
PAPER_EXECUTION_CRYPTO_BROKER_ID=alpaca_paper
PAPER_EXECUTION_ALLOWED_STRATEGIES=mean_reversion.snapback,crypto_momentum.trend,momentum.volatility_breakout
IG_API_KEY=replace_me_ig_api_key
IG_USERNAME=replace_me_ig_username
IG_PASSWORD=replace_me_ig_password
IG_ACCOUNT_TYPE=DEMO
IG_ACCOUNT_NUMBER=replace_me_ig_account_number
IG_BASE_URL=https://demo-api.ig.com/gateway/deal
IG_REQUEST_TIMEOUT_SECONDS=10
IG_MIN_BET_PER_POINT_GBP=0.10
IG_EPIC_OVERRIDES=AAPL:ED.D.AAPL.CASH.IP
IG_REQUEST_COST_USD=0.00

# Alpaca paper trading
ALPACA_API_KEY=replace_me
ALPACA_SECRET_KEY=replace_me
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_STOCK_FEED=iex
ALPACA_REQUEST_TIMEOUT_SECONDS=10
ALPACA_WATCHLIST_SYMBOLS=AAPL,ABNB,ADBE,ADI,ADP,ADSK,AEP,ALNY,AMAT,AMD,AMGN,AMZN,APP,ARM,ASML,AVGO,AXON,BKNG,BKR,CCEP,CDNS,CEG,CHTR,CMCSA,COST,CPRT,CRWD,CSCO,CSGP,CSX,CTAS,CTSH,DASH,DDOG,DXCM,EA,EXC,FANG,FAST,FER,FTNT,GEHC,GILD,GOOG,GOOGL,HON,IDXX,INSM,INTC,INTU,ISRG,KDP,KHC,KLAC,LIN,LRCX,MAR,MCHP,MDLZ,MELI,META,MNST,MPWR,MRVL,MSFT,MSTR,MU,NFLX,NVDA,NXPI,ODFL,ORLY,PANW,PAYX,PCAR,PDD,PEP,PLTR,PYPL,QCOM,REGN,ROP,ROST,SBUX,SHOP,SNPS,STX,TEAM,TMUS,TRI,TSLA,TTWO,TXN,VRSK,VRTX,WBD,WDAY,WDC,WMT,XEL,ZS
ALPACA_CRYPTO_LOCATION=us
ALPACA_CRYPTO_SYMBOLS=BTC/USD,ETH/USD,SOL/USD,XRP/USD,DOGE/USD
HISTORICAL_BACKFILL_DEFAULT_DAYS=30
HISTORICAL_BACKFILL_DEFAULT_TIMEFRAME=1Min
HISTORICAL_REPLAY_DEFAULT_DAYS=30
HISTORICAL_REPLAY_DEFAULT_TIMEFRAME=1Hour
HISTORICAL_REPLAY_MAX_TIMESTAMPS=0
DISCOVERY_EQUITY_SYMBOLS=AAPL,ABNB,ADBE,ADI,ADP,ADSK,AEP,ALNY,AMAT,AMD,AMGN,AMZN,APP,ARM,ASML,AVGO,AXON,BKNG,BKR,CCEP,CDNS,CEG,CHTR,CMCSA,COST,CPRT,CRWD,CSCO,CSGP,CSX,CTAS,CTSH,DASH,DDOG,DXCM,EA,EXC,FANG,FAST,FER,FTNT,GEHC,GILD,GOOG,GOOGL,HON,IDXX,INSM,INTC,INTU,ISRG,KDP,KHC,KLAC,LIN,LRCX,MAR,MCHP,MDLZ,MELI,META,MNST,MPWR,MRVL,MSFT,MSTR,MU,NFLX,NVDA,NXPI,ODFL,ORLY,PANW,PAYX,PCAR,PDD,PEP,PLTR,PYPL,QCOM,REGN,ROP,ROST,SBUX,SHOP,SNPS,STX,TEAM,TMUS,TRI,TSLA,TTWO,TXN,VRSK,VRTX,WBD,WDAY,WDC,WMT,XEL,ZS
DISCOVERY_CRYPTO_SYMBOLS=BTC/USD,ETH/USD,SOL/USD,XRP/USD,DOGE/USD
DISCOVERY_TARGET_COUNT=6
ALPACA_REQUEST_COST_USD=0.00
ALPACA_DATA_REQUEST_COST_USD=0.00
ALPACA_CRYPTO_DATA_REQUEST_COST_USD=0.00

# GBP conversion via free ECB reference rates
ECB_REFERENCE_RATES_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml
ECB_REQUEST_TIMEOUT_SECONDS=10
ECB_REFERENCE_CACHE_MINUTES=60

# PostgreSQL / pgvector
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ghostfrog_centaur
POSTGRES_USER=replace_me
POSTGRES_PASSWORD=replace_me
POSTGRES_SSLMODE=prefer
DATABASE_URL=postgresql://replace_me:replace_me@127.0.0.1:5432/ghostfrog_centaur

# Optional data providers
POLYGON_API_KEY=replace_me_optional
POLYGON_REQUEST_COST_USD=0.00
NEWS_API_KEY=replace_me_optional
NEWS_API_REQUEST_COST_USD=0.00

# Shared secrets
APP_SHARED_SECRET=replace_me
WEBHOOK_SECRET=replace_me
