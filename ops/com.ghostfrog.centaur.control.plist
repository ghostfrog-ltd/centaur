<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ghostfrog.centaur.control</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/garyconstable/.centaur/run_control_tick.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Volumes/Bob/www/ghostfrog-centaur</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PRE_REPLAY_HISTORICAL_REFRESH_ENABLED</key>
        <string>true</string>
        <key>PRE_REPLAY_HISTORICAL_REFRESH_DRY_RUN</key>
        <string>false</string>
        <key>REPLAY_WINDOW_SELECTION_MODE</key>
        <string>asset_class_and_timeframe</string>
        <key>ROLLING_REPLAY_CURSOR_ENABLED</key>
        <string>true</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

</dict>
</plist>
