# Local secrets and runtime config
.env
.env.*
!.env.example
*.local
*.local.*

# Python environments and caches
.venv/
.venv-*/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Runtime state and local databases
/.runtime/
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# Logs and process files
logs/*
!logs/.gitkeep
*.log
*.pid
web/cache/*
!web/cache/.gitkeep

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Dependency/build output
node_modules/
vendor/
dist/
build/
.cache/
.parcel-cache/
.next/

# Model/data caches and bulky generated artifacts
.hf-cache/
*.pkl
*.pickle
*.parquet
*.feather

