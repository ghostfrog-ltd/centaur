flowchart TD
  universe["Configured symbol universe<br/>DISCOVERY_EQUITY_SYMBOLS<br/>DISCOVERY_CRYPTO_SYMBOLS"]
  bars["Latest market bars<br/>equity batch + crypto batch"]
  candidates["Ranked candidates<br/>movement + liquidity"]
  selected["Selected candidates<br/>top DISCOVERY_TARGET_COUNT"]
  strategies["Strategy evaluation<br/>profile-specific setup rules"]
  signals["Strategy signals<br/>entry, stop, target, score, confidence"]
  fitness{"Fitness allocation"}
  suppressed["Suppressed<br/>stop before proposal"]
  surviving["Surviving signals<br/>unproven / weighted / favored / override"]
  proposals["Shadow proposals<br/>watch/evidence rows"]
  cfo{"Paper CFO risk gate<br/>PAPER_* dials"}
  hold["Hold<br/>no new entry"]
  paper["Paper order request<br/>approved"]
  execution["Execution router<br/>broker adapter"]
  order["Submitted order<br/>if broker accepts"]
  live_cfo{"Live CFO risk gate<br/>LIVE_* dials"}
  live_guard["LiveRiskGuard<br/>final broker mutation boundary"]
  live_order["Live order<br/>trade / skip / block audited"]

  universe --> bars
  bars --> candidates
  candidates --> selected
  selected --> strategies
  strategies --> signals
  signals --> fitness
  fitness -->|below threshold| suppressed
  fitness -->|passes allocation| surviving
  surviving --> proposals
  proposals --> cfo
  cfo -->|rejected / no slots / kill switch / protection| hold
  cfo -->|approved| paper
  paper --> execution
  execution --> order
  proposals --> live_cfo
  live_cfo -->|blocked| hold
  live_cfo -->|approved| live_guard
  live_guard --> live_order
